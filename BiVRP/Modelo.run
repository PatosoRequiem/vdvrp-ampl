printf "TIEMPO CPU\n" ;
printf "%.4f\n" , sum{i in objetivos}TCPU1[i] + sum{i in ejecuciones}TCPU2[i] ;

printf "\n" ;
printf "----------------------------------------------------------\n" ;
printf "----------------------------------------------------------\n" ;
printf "----------------------------------------------------------\n" ;
printf "\n" 

		;
	reset data X, Y, t, F, alpha			;
	}

display MVF, PVF, TCPU1 > mejorypeorvalor.txt;
display FN1, FN2, F1, F2, BT1, BT2, TCPU2 > tabla.txt ;


		
